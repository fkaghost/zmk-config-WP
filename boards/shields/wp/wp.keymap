/*
 * WP / Corne Wireless - Left Half Only
 * nice!nano v2
 * Typeractive 6-column left PCB
 *
 * Bluetooth / Layout behavior:
 *
 * PLAY:
 *   Tap BT     -> Bluetooth Profile 2 + Work layout
 *   Hold 4 sec -> Clear current BT profile for re-pairing
 *
 * WORK:
 *   Tap BT     -> Bluetooth Profile 1 + Play layout
 *   Hold 4 sec -> Clear current BT profile for re-pairing
 *
 * Layers:
 *
 * Layer 0 = Bluetooth Profile 1 - Play
 * Layer 1 = Bluetooth Profile 2 - Work
 * Layer 2 = Work Layer 2
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    macros {

        /*
         * Hold action:
         *
         * Clear bond information for the currently
         * selected Bluetooth profile.
         *
         * Once cleared, ZMK will advertise that profile
         * so it can be paired again.
         */
        bt_pairing_macro: bt_pairing_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            bindings = <
                &bt BT_CLR
            >;
        };


        /*
         * PLAY -> WORK
         *
         * Explicitly select BT Profile 2
         * and activate Work layer.
         *
         * ZMK BT profiles are zero-indexed:
         *
         * Profile 1 = BT_SEL 0
         * Profile 2 = BT_SEL 1
         */
        play_to_work_macro: play_to_work_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            bindings = <
                &bt BT_SEL 1
                &to 1
            >;
        };


        /*
         * WORK -> PLAY
         *
         * Explicitly select BT Profile 1
         * and return to Play/base layer.
         */
        work_to_play_macro: work_to_play_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            bindings = <
                &bt BT_SEL 0
                &to 0
            >;
        };
    };


    behaviors {

        /*
         * BT key while on PLAY
         *
         * TAP:
         *   Profile 2 + Work
         *
         * HOLD 4 seconds:
         *   Clear current Bluetooth profile
         */
        bt_play_switch: bt_play_switch {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            tapping-term-ms = <4000>;
            flavor = "tap-preferred";

            bindings = <
                &bt_pairing_macro
                &play_to_work_macro
            >;
        };


        /*
         * BT key while on WORK
         *
         * TAP:
         *   Profile 1 + Play
         *
         * HOLD 4 seconds:
         *   Clear current Bluetooth profile
         */
        bt_work_switch: bt_work_switch {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            tapping-term-ms = <4000>;
            flavor = "tap-preferred";

            bindings = <
                &bt_pairing_macro
                &work_to_play_macro
            >;
        };
    };


    keymap {
        compatible = "zmk,keymap";


        // =========================================================
        // LAYER 0
        //
        // Bluetooth Profile 1
        // PLAY
        //
        // ┌──────┬─────┬───┬───┬───┬───┐
        // │  BT  │ TAB │ Q │ W │ E │ R │
        // ├──────┼─────┼───┼───┼───┼───┤
        // │ MUTE │CAPS │ A │ S │ D │ F │
        // ├──────┼─────┼───┼───┼───┼───┤
        // │      │SHFT │ Z │ X │ C │   │
        // └──────┴─────┴───┴───┴───┴───┘
        //
        //              ┌───┬───┬───────┐
        //              │ 1 │ 2 │ SPACE │
        //              └───┴───┴───────┘
        //
        // =========================================================

        profile_1_layer {
            display-name = "Play";

            bindings = <
                &bt_play_switch 0 0   &kp TAB     &kp Q   &kp W   &kp E   &kp R

                &kp C_MUTE            &kp CAPS    &kp A   &kp S   &kp D   &kp F

                &none                 &kp LSHFT   &kp Z   &kp X   &kp C   &none

                                      &kp N1      &kp N2  &kp SPACE
            >;
        };


        // =========================================================
        // LAYER 1
        //
        // Bluetooth Profile 2
        // WORK
        //
        // ┌──────┬───────┬────────┬──────┬───────┬──────────────┐
        // │  BT  │       │ DELETE │ HOME │  END  │              │
        // ├──────┼───────┼────────┼──────┼───────┼──────────────┤
        // │ MUTE │       │  BSPC  │ COPY │ PASTE │ SPECIAL PASTE│
        // ├──────┼───────┼────────┼──────┼───────┼──────────────┤
        // │      │       │  CUT   │ SELA │       │              │
        // └──────┴───────┴────────┴──────┴───────┴──────────────┘
        //
        //                   ┌──────┬───────┬────┐
        //                   │ NONE │ SPACE │ L2 │
        //                   └──────┴───────┴────┘
        //
        // Copy          = Ctrl+C
        // Paste         = Ctrl+V
        // Special Paste = Ctrl+Shift+V
        // Cut           = Ctrl+X
        // Select All    = Ctrl+A
        //
        // =========================================================

        profile_2_default_layer {
            display-name = "Work";

            bindings = <
                &bt_work_switch 0 0   &none       &kp DEL        &kp HOME      &kp END        &none

                &kp C_MUTE            &none       &kp BSPC       &kp LC(C)     &kp LC(V)      &kp LC(LS(V))

                &none                 &none       &kp LC(X)      &kp LC(A)     &none          &none

                                      &none        &kp SPACE      &mo 2
            >;
        };


        // =========================================================
        // LAYER 2
        //
        // WORK L2
        //
        // Hold the bottom-right thumb key from Work.
        //
        // ┌──────┬───────┬───────┬──────┬────────┬───────┐
        // │  BT  │       │       │ UNDO │  REDO  │       │
        // ├──────┼───────┼───────┼──────┼────────┼───────┤
        // │ MUTE │       │  TAB  │ BOLD │ ITALIC │       │
        // ├──────┼───────┼───────┼──────┼────────┼───────┤
        // │      │       │S+TAB  │      │ PRINT  │       │
        // └──────┴───────┴───────┴──────┴────────┴───────┘
        //
        //                  ┌──────┬──────┬─────────┐
        //                  │ NONE │ NONE │ THROUGH │
        //                  └──────┴──────┴─────────┘
        //
        // Undo      = Ctrl+Z
        // Redo      = Ctrl+Shift+Z
        // Bold      = Ctrl+B
        // Italic    = Ctrl+I
        // Shift+Tab = Shift+Tab
        //
        // =========================================================

        profile_2_layer_2 {
            display-name = "Work L2";

            bindings = <
                &trans       &none       &none          &kp LC(Z)       &kp LC(LS(Z))   &none

                &kp C_MUTE   &none       &kp TAB        &kp LC(B)       &kp LC(I)       &none

                &none        &none       &kp LS(TAB)    &none           &kp PSCRN       &none

                             &none        &none          &trans
            >;
        };
    };
};
